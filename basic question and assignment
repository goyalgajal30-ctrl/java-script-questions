//q35
let N = 10;
let sum = 0;

function isPrime(n) {
  if (n <= 1) return false;
  for (let i = 2; i <= Math.sqrt(n); i++)
    if (n % i === 0) return false;
  return true;
}
for (let i = 2; i <= N; i++) {
  if (isPrime(i)) sum += i;
}
console.log(sum);









